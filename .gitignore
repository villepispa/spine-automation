# Local noise
*.log
TestResults/
/testResults.xml
*.user

# OS / editor
.DS_Store
Thumbs.db
.idea/

# Repo-root Cursor agent / VM state only (keep local-only).
# Negation: templates/ps-product-shellguard/.cursor/ must remain trackable.
/.cursor/
_archive/

# Secrets
.env
.env.*
*.pem
